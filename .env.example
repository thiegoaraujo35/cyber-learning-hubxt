# Supabase — copie para .env.local e preencha. NUNCA versione o .env.local.
# Local (Supabase CLI): rode `npx supabase start` e use os valores exibidos.
# Nuvem: Project Settings > API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas servidor (nunca expor no front-end; sem prefixo NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=

# Modo visualização (apenas `npm run dev`): true = abre o app sem login e sem Supabase.
# Ignorado em produção. Deixe false quando o Supabase estiver configurado.
DEV_BYPASS_AUTH=false
